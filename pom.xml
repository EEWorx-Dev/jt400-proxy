<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.eeworx.utils</groupId>
    <artifactId>jt400-proxy</artifactId>
    <version>0.1.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jt400-proxy</name>
    <description>jt400 / AS400 proxy with Java server and Node.js client</description>

    <scm>
        <connection>scm:git:https://github.com/eeworx-dev/jt400-proxy.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/eeworx-dev/jt400-proxy.git</developerConnection>
        <url>https://github.com/eeworx-dev/jt400-proxy</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>server</module>
        <!-- client module drives npm install, test, version sync and publish via frontend-maven-plugin -->
        <module>client</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <distributionManagement>
        <!-- Maven artifacts (the server JAR) will be deployed to GitHub Packages -->
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/eeworx-dev/jt400-proxy</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <!-- Maven Release Plugin configuration at root for coordinated releases -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.0.1</version>
                <configuration>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <useReleaseProfile>false</useReleaseProfile>
                    <releaseProfiles>release</releaseProfiles>
                    <!-- Hybrid release model:
                         - Use mvn release:prepare (locally or in CI) to bump versions across
                           all modules (including syncing client/package.json via frontend-maven-plugin),
                           commit, and create the git tag.
                         - preparationGoals + goals=verify ensure that release:prepare/perform
                           stop before any deploy step.
                         - The actual artifact deploy (server to Maven GH Packages + client npm)
                           is done by this repo's GitHub Actions workflow on the release event
                           (see .github/workflows/publish-jt400-proxy.yml). This centralizes auth
                           (GITHUB_TOKEN with packages:write) and avoids running deploys from
                           developer machines. -->
                    <preparationGoals>clean verify</preparationGoals>
                    <goals>verify</goals>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
