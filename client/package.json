{
  "name": "@eeworx-dev/jt400-proxy-client",
  "version": "0.1.0-SNAPSHOT",
  "description": "Dual-mode jt400 proxy client for Node.js: use as a library or run as a standalone HTTP server. Bridges to a stable Java Hikari-backed jt400 proxy over duplex TCP.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./facade": "./facade.js",
    "./server": "./facade.js"
  },
  "bin": {
    "jt400-proxy-client": "bin/cli.js"
  },
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "example": "node example-direct.js",
    "test": "node --test",
    "test:framing": "node -e 'require(\"./index\").selfTestFraming && console.log(\"framing self-test ok\")'",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eeworx-dev/jt400-proxy.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "jt400",
    "as400",
    "db2",
    "ibm-i",
    "proxy",
    "hikari",
    "standalone-server",
    "connection-pool"
  ],
  "author": "Elisha Ebenezer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18"
  }
}
