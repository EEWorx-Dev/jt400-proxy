<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.eeworx.utils</groupId>
        <artifactId>jt400-proxy</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jt400-proxy-client</artifactId>
    <packaging>pom</packaging>

    <name>jt400-proxy-client</name>
    <description>Node.js client for jt400-proxy-server (library + HTTP facade)</description>

    <build>
        <plugins>
            <!-- Frontend Maven Plugin: handles Node.js / npm lifecycle inside Maven -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>

                <configuration>
                    <installDirectory>${project.build.directory}</installDirectory>
                </configuration>

                <executions>
                    <!-- Install Node + npm (matches your production Node 24) -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v24.0.0</nodeVersion>
                            <npmVersion>10.7.0</npmVersion>
                        </configuration>
                    </execution>

                    <!-- Install npm dependencies -->
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>

                    <!-- Run tests (aligns with existing "prepublishOnly": "npm test") -->
                    <execution>
                        <id>npm-test</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>test</arguments>
                        </configuration>
                    </execution>

                    <!-- Sync Maven version to package.json during release prepare -->
                    <!-- The maven-release-plugin updates the pom version first -->
                    <execution>
                        <id>npm-version</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <arguments>version ${project.version} --no-git-tag-version --allow-same-version</arguments>
                        </configuration>
                    </execution>

                    <!-- Publish to GitHub Packages (or npmjs) during deploy phase -->
                    <!-- This runs as part of "mvn deploy" / release:perform -->
                    <execution>
                        <id>npm-publish</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>deploy</phase>
                        <configuration>
                            <arguments>publish --access public</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
