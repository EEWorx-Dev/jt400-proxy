<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.eeworx.utils.jt400</groupId>
        <artifactId>jt400-proxy</artifactId>
        <version>0.1.4-SNAPSHOT</version>
    </parent>

    <artifactId>jt400-proxy-client</artifactId>
    <packaging>pom</packaging>

    <name>jt400-proxy-client</name>
    <description>Node.js client for jt400-proxy-server (library + HTTP facade)</description>

    <profiles>
        <profile>
            <id>publish-to-npm</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>npm-publish-registry</id>
                                <!-- Binds to the deploy phase so it runs when you execute 'mvn deploy' -->
                                <phase>deploy</phase> 
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>publish</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- Frontend Maven Plugin: handles Node.js / npm lifecycle inside Maven -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>

                <configuration>
                    <installDirectory>${project.build.directory}</installDirectory>
                </configuration>

                <executions>
                    <!-- Install Node + npm (matches your production Node 24) -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v24.0.0</nodeVersion>
                            <npmVersion>10.7.0</npmVersion>
                        </configuration>
                    </execution>

                    <!-- Install npm dependencies -->
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>

                    <!-- Run tests (aligns with existing "prepublishOnly": "npm test") -->
                    <execution>
                        <id>npm-test</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>test</arguments>
                        </configuration>
                    </execution>

                    <!-- Sync Maven version to package.json during release prepare -->
                    <!-- The maven-release-plugin updates the pom version first.
                    A follow-up exec-maven-plugin execution (below) does "git add" on
                    package.json + package-lock.json so that release:prepare will
                    actually commit them (otherwise they are often skipped). -->
                    <execution>
                        <id>npm-version</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <arguments>version ${project.version} --no-git-tag-version --allow-same-version</arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>npm-pack</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <arguments>pack --pack-destination=${project.build.directory}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>attach-frontend-tarball</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/eeworx-dev-${project.artifactId}-${project.version}.tgz</file> 
                                    <type>tgz</type>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            
            <!-- Exec plugin: ensures that package.json + package-lock.json
            (updated by the "npm version" execution above during release:prepare)
            are explicitly staged so the maven-release-plugin will commit them.
            Without this, release:prepare often only commits the POM files
            and skips the Node package files (known gotcha). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>git-add-package-files-for-release</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <executable>git</executable>
                            <arguments>
                                <argument>add</argument>
                                <argument>package.json</argument>
                                <argument>package-lock.json</argument>
                            </arguments>
                            <!-- Fail the build if git add fails (e.g. not a git repo) -->
                            <successCodes>
                                <successCode>0</successCode>
                            </successCodes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
