@echo off
REM Copy this file to env.bat (in the same directory as run.bat)
REM and fill in your values. run.bat will call it automatically if present.
REM
REM These are the same variables as .env.example but using Windows SET syntax.

set AS400_HOST=192.168.88.170
set AS400_USER=youruser
set AS400_PASSWORD=yourpass
set AS400_DATABASE=MBMWALTPRD

set AS400_JDBC_PROPS=translate binary=true;prompt=false;tcp no delay=true;errors=full

set PROXY_TCP_HOST=0.0.0.0
set PROXY_TCP_PORT=9400

set HIKARI_MAX_POOL_SIZE=20
set HIKARI_MIN_IDLE=5
set HIKARI_CONNECTION_TIMEOUT_MS=30000
set HIKARI_IDLE_TIMEOUT_MS=600000
set HIKARI_MAX_LIFETIME_MS=1800000
set HIKARI_KEEPALIVE_TIME_MS=120000
set HIKARI_VALIDATION_TIMEOUT_MS=5000
set HIKARI_CONNECTION_TEST_QUERY=SELECT 1 FROM SYSIBM.SYSDUMMY1
set HIKARI_CONNECTION_ACQUIRE_RETRIES=2

set TX_TIMEOUT_MS=300000
set TX_SWEEPER_INTERVAL_MS=30000

REM set JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC
REM set LOG_LEVEL=INFO
