# jt400-proxy-server environment variables
# Copy this file to .env (or .env.local) and fill in your values.
# The run.sh / start.sh scripts will source it automatically if present.
# You can also pass a custom file: ./run.sh my.env
#
# On Windows, copy relevant values to env.bat (see env.bat.example).
# run.bat / start.bat will load it by default, or accept it as first argument.

# === AS/400 Connection (required) ===
AS400_HOST=192.168.88.170
AS400_USER=youruser
AS400_PASSWORD=yourpass
AS400_DATABASE=MBMWALTPRD

# Extra JDBC properties (semicolon separated)
AS400_JDBC_PROPS=translate binary=true;prompt=false;tcp no delay=true;errors=full

# === Proxy Server ===
PROXY_TCP_HOST=0.0.0.0
PROXY_TCP_PORT=9400

# === HikariCP Pool Tuning ===
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT_MS=30000
HIKARI_IDLE_TIMEOUT_MS=600000
HIKARI_MAX_LIFETIME_MS=1800000
HIKARI_KEEPALIVE_TIME_MS=120000
HIKARI_VALIDATION_TIMEOUT_MS=5000
HIKARI_CONNECTION_TEST_QUERY=SELECT 1 FROM SYSIBM.SYSDUMMY1
HIKARI_CONNECTION_ACQUIRE_RETRIES=2

# === Transaction (parked connection) Sweeper ===
TX_TIMEOUT_MS=300000
TX_SWEEPER_INTERVAL_MS=30000

# === Logging (optional) ===
LOG_LEVEL=INFO

# === JVM Options (optional, passed through JAVA_OPTS) ===
# JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC
